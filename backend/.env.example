# ==============================================================================
# SERVER CONFIGURATION
# ==============================================================================
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# ==============================================================================
# CORS & CLIENT CONFIGURATION
# ==============================================================================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ==============================================================================
# DATABASE CONFIGURATION (MONGODB ATLAS / LOCAL)
# ==============================================================================
MONGODB_URI=mongodb://localhost:27017/ats_resume_platform
MONGODB_MAX_POOL_SIZE=10
MONGODB_MIN_POOL_SIZE=2
MONGODB_CONNECT_TIMEOUT_MS=10000

# ==============================================================================
# SECURITY & AUTHENTICATION SECRETS
# ==============================================================================
JWT_ACCESS_SECRET=your_super_secret_access_token_key_change_in_production
JWT_REFRESH_SECRET=your_super_secret_refresh_token_key_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=your_secure_cookie_signing_secret_here

# ==============================================================================
# RATE LIMITING
# ==============================================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ==============================================================================
# LOGGING CONFIGURATION
# ==============================================================================
LOG_LEVEL=debug
LOG_DIR=logs

# ==============================================================================
# CLOUDINARY CONFIGURATION (STORAGE)
# ==============================================================================
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=ats_resumes
MAX_FILE_SIZE_MB=5

# ==============================================================================
# GOOGLE GEMINI AI CONFIGURATION
# ==============================================================================
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ==============================================================================
# SMTP EMAIL CONFIGURATION
# ==============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password_here
SMTP_FROM=AI ATS Platform <noreply@atsplatform.dev>
CLIENT_URL=http://localhost:5173
APP_NAME="AI-Powered ATS Resume Builder & Job Tracker"



