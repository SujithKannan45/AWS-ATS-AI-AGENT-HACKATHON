# ATS Express API (existing backend; user identity comes from JWT only)
ATS_API_BASE_URL=http://127.0.0.1:5000/api/v1
ATS_HTTP_TIMEOUT_SECONDS=60

# Amazon Bedrock (server-side only; never expose to browser)
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Local Strands Decider 2B server (see README — pip install strands-decider, then serve)
STRANDS_DECIDER_URL=http://127.0.0.1:8099
TOOL_SELECTION_MIN_CONFIDENCE=0.45

# Agent HTTP service
AGENT_HOST=127.0.0.1
AGENT_PORT=8080
LOG_LEVEL=INFO

# Max characters accepted for a user message (validated server-side)
MAX_USER_MESSAGE_CHARS=8000

# Reserved: parsed by config but not currently used by the startup path.
SKIP_BEDROCK_STARTUP_CHECK=false
